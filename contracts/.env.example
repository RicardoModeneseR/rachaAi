# Copie para .env (que NUNCA é commitado) e preencha.
# URL RPC da Sepolia (Alchemy ou Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_CHAVE
# Chave privada da carteira criada SÓ para o projeto (sem dinheiro de verdade)
PRIVATE_KEY=0xSUA_CHAVE_PRIVADA
# Chave da API do Etherscan, usada pelo `npx hardhat verify`
ETHERSCAN_API_KEY=SUA_CHAVE_ETHERSCAN
